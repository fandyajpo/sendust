# Copy to .env and fill in your relay. .env is git-ignored: never commit real
# values, and use an app-specific password rather than an account password.
#
# Both examples read this file, and real environment variables win over it.

# Relay
SENDUST_HOST=smtp.example.com
SENDUST_PORT=465
# tls = implicit TLS (usually 465), starttls = upgrade required (usually 587)
SENDUST_SECURITY=tls

# Optional authentication. Set both or neither.
SENDUST_USER=
SENDUST_PASS=

# Message
SENDUST_FROM="Sendust Test <noreply@example.com>"
SENDUST_TO=you@example.com
SENDUST_SUBJECT=Hello from Sendust
SENDUST_TEXT=Sent by the Sendust example.

# Optional, Rust example only: extra PEM trust anchor for a local test relay.
# SENDUST_EXTRA_ROOT=tests/fixtures/tls/ca.crt
