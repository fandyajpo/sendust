{
  "name": "@sendust/ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sendust runtime-neutral TypeScript facade workspace",
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
