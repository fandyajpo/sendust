{
  "name": "@sendust/ts",
  "version": "1.4.0",
  "description": "Standalone native email delivery engine for Node.js, Bun, and Deno: mandatory-TLS SMTP with XOAUTH2 and DKIM, behind a narrow TypeScript facade over a bundled Node-API addon",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fandyajpo/sendust.git"
  },
  "homepage": "https://sendust-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/fandyajpo/sendust/issues"
  },
  "keywords": [
    "email",
    "smtp",
    "smtp-client",
    "mail",
    "sendmail",
    "transactional-email",
    "dkim",
    "xoauth2",
    "oauth2",
    "mime",
    "attachments",
    "typescript",
    "nodejs",
    "bun",
    "deno",
    "native",
    "rust",
    "napi"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "sendust.node",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
