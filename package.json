{
  "name": "sendust",
  "version": "1.0.1",
  "description": "Standalone native email delivery engine for Node.js, Bun, and Deno",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "ts"
  ],
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:doc-claims": "node scripts/check-doc-claims.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run check:architecture && npm run check:docs && npm run check:doc-claims && npm run check:versions",
    "lint": "npm --workspace ./ts run lint",
    "format:check": "npm --workspace ./ts run format:check",
    "typecheck": "npm --workspace ./ts run typecheck",
    "test": "npm --workspace ./ts run test",
    "build:native": "node scripts/build-addon.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "prepare:publish": "node scripts/prepare-publish.mjs",
    "pack:platform": "node scripts/pack-platform.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "assemble:rc": "node scripts/assemble-rc.mjs",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "nodemailer": "^10.6.0"
  }
}
